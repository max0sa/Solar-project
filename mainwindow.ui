  <property name="styleSheet">
   <string notr="true">/* Fondo de la aplicación */
QMainWindow {
    background-color: #e6e7e8;
}

/* Títulos de los contenedores */
QGroupBox {
    font-weight: bold;
    font-size: 13px;
    color: #2c3e50;
    border: 1px solid #dcdde1;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 16px;
}

/* Botones de acción y selección */
QPushButton {
    background-color: #27ae60; /* Verde ecológico para un proyecto solar */
    color: white;
    border-radius: 5px;
    padding: 8px 16px;
    font-weight: bold;
    font-size: 12px;
}
QPushButton:hover {
    background-color: #2ecc71;
}
QPushButton:pressed {
    background-color: #1e8449;
}

/* Cuadro de texto de Resultados */
QTextBrowser {
    background-color: #ffffff;
    border: 1px solid #dcdde1;
    border-radius: 6px;
    padding: 12px;
    font-size: 13px;
    color: #34495e;
}

/* Tabla de Presupuesto */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #dcdde1;
    border-radius: 6px;
    gridline-color: #f1f2f6;
    font-size: 13px;
}
QHeaderView::section {
    background-color: #f1f2f6;
    padding: 6px;
    font-weight: bold;
    border: none;
    color: #2c3e50;
}</string>
  </property>
